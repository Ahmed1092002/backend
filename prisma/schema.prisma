generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                 String              @id @default(uuid())
  name               String
  price              Decimal             @db.Decimal(10, 2)
  stock              Int                 @default(0)
  imagePath          String?
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

model InventoryMovement {
  id        String   @id @default(uuid())
  productId String
  delta     Int
  note      String?
  actorId   String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Supports the product stock-history query: filter by product, then show
  // the newest movements first. The matching index already exists in the
  // original SQL migration; this keeps Prisma's schema in sync with it.
  @@index([productId, createdAt])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String?
  role         UserRole @default(USER)
  refreshTokens RefreshToken[]
  orders        Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id          String      @id @default(uuid())
  status      OrderStatus @default(DRAFT)
  total       Decimal     @db.Decimal(10, 2)
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  createdBy User        @relation(fields: [createdById], references: [id])
  items     OrderItem[]
  idempotencyKey IdempotencyKey?
}

model IdempotencyKey {
  id          String   @id @default(uuid())
  scope       String
  key         String
  requestHash String
  orderId     String   @unique
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([scope, key])
}

// A durable record of a business event that must be handled after the
// transaction commits. It is deliberately generic: more event types can use
// this same table later.
model OutboxEvent {
  id          String    @id @default(uuid())
  type        String
  payload     Json
  createdAt   DateTime  @default(now())
  availableAt DateTime  @default(now())
  processedAt DateTime?
  failedAt    DateTime?
  lockedAt    DateTime?
  lockedBy    String?
  attempts    Int       @default(0)
  lastError   String?
  attemptHistory OutboxEventAttempt[]

  // The future worker asks for pending, unlocked events in creation order.
  @@index([processedAt, failedAt, availableAt, lockedAt, createdAt])
}

model OutboxEventAttempt {
  id            String   @id @default(uuid())
  outboxEventId String
  attemptNumber Int
  error         String
  attemptedAt   DateTime @default(now())

  outboxEvent OutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)

  // A replay resets the parent attempt counter, so the history itself remains
  // append-only instead of treating an old attempt number as the same record.
  @@index([outboxEventId, attemptedAt])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  productId   String
  productName String
  unitPrice   Decimal  @db.Decimal(10, 2)
  quantity    Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum UserRole {
  ADMIN
  MANAGER
  USER
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}
